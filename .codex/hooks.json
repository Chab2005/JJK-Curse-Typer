{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/chab/Project_School/WEB_5/Projet_Type_Monkey/MonkeyTyper/.codex/hooks/auto-commit.sh' track"
          },
          {
            "type": "command",
            "command": "node '/Users/chab/Project_School/WEB_5/Projet_Type_Monkey/MonkeyTyper/.codex/hooks/new-method.mts'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/chab/Project_School/WEB_5/Projet_Type_Monkey/MonkeyTyper/.codex/hooks/auto-commit.sh' stop"
          }
        ]
      }
    ]
  }
}
