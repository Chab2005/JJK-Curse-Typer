DATABASE_URL=postgres://postgres:postgres@localhost:5432/monkeytyper


# Clé qui signe les cookies (obligatoire en production) : `openssl rand -base64 32`
AUTH_SECRET=
# URL publique de l'app, base des adresses de retour OAuth (…/api/auth/<provider>/callback)
APP_URL=http://localhost:3000
# Applications OAuth (sans elles, les boutons Discord et GitHub répondent « indisponible »)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Les données de démonstration (classement, lobbies, profils) sont masquées en production ; 1 les rallume
SHOW_SAMPLE_DATA=
